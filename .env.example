# ==============================================================================
# Event Ticketing & Flash Sale Platform - Environment Configuration
# Copy to .env and fill secrets before running in staging/production.
# Never commit .env or real credentials to Git!
# ==============================================================================

# Database
POSTGRES_DB=ticketing
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/ticketing
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Backend
SPRING_PROFILES_ACTIVE=docker
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# Security Secrets (Use strong >= 32-byte random strings in non-local envs)
JWT_SECRET=dev-only-jwt-secret-key-at-least-32-bytes-long-2026
QR_HMAC_SECRET=dev-only-qr-hmac-secret-key-at-least-32-bytes-long
ADMISSION_TOKEN_SECRET=dev-only-admission-token-secret-32-bytes-long

# Payment Gateways (Leave blank to use Local Sandbox Simulator)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# Mail (SMTP)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws

# Monitoring (Optional profile: monitoring)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
